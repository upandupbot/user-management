# Copy to /home/ubuntu/user-management/.env and fill in, then:
#   chmod 600 /home/ubuntu/user-management/.env
# One KEY=value per line, no quotes, no multi-line values (systemd reads
# this file and doesn't understand multi-line entries).

# Required
PIPEFY_API_TOKEN=replace-with-pipefy-token
SWAP_WEB_PASSWORD=replace-with-shared-team-password

# Optional: signs session cookies. If unset, a key is derived from
# SWAP_WEB_PASSWORD, so changing the password signs everyone out.
# SWAP_WEB_SECRET_KEY=replace-with-a-long-random-string

# Shared Google Sheet for History, notifications and saved co-assignee
# additions. Without these, History only shows this server's own changes.
SWAP_AUDIT_SHEET_ID=replace-with-sheet-id
# Path to the service-account key file on the server (chmod 600).
# Use the file, not SWAP_AUDIT_SERVICE_ACCOUNT_JSON: the key is multi-line
# JSON, which doesn't fit in this file.
SWAP_AUDIT_SERVICE_ACCOUNT_FILE=/home/ubuntu/user-management-secrets/service-account.json

# Optional
# PAPERTRAIL_LOG_TOKEN=
# SWAP_AUDIT_RETENTION_DAYS=365
